# Discord Bot Token
DISCORD_TOKEN=your_discord_token_here

# Hugging Face 令牌
HUGGINGFACE_TOKEN=your_huggingface_token_here

# LLM 設定
DEFAULT_LLM_TYPE=local_python
FALLBACK_LLM_TYPE=gemini
ENABLE_FALLBACK=true
FALLBACK_TIMEOUT=30

# OpenAI API 設定
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Gemini API 設定
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.0-pro

# Anthropic API 設定
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# 本地 LLM API 設定 (如果您使用 Ollama 等本地 API 服務)
LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=llama3

# 本地 Python LLM 設定 - 針對 RTX 4090 優化
# LOCAL_MODEL_NAME= models/your_local_model_name.gguf
# LOCAL_MODEL_NAME = mistralai/Mixtral-8x7B-Instruct-v0.1
LOCAL_MODEL_NAME=microsoft/phi-3-mini-4k-instruct
LOCAL_MODEL_CACHE_DIR=./LOCAL_MODEL_USE_FLASH_ATTN

# GGUF 模型配置
LOCAL_GGUF_MODEL_PATH = "path/to/your/gguf_model_file.gguf"
GGUF_CONTEXT_SIZE = 4096
GGUF_GPU_LAYERS = -1  # -1 表示使用所有可用的 GPU 層

# 硬體優化設定
LOCAL_MODEL_DEVICE=cuda
LOCAL_MODEL_DTYPE=bfloat16
LOCAL_MODEL_USE_FLASH_ATTN=true
LOCAL_MODEL_QUANTIZATION=auto

# 生成參數
LOCAL_MODEL_MAX_NEW_TOKENS=1024
LOCAL_MODEL_TEMPERATURE=0.7
LOCAL_MODEL_TOP_P=0.9
LOCAL_MODEL_REPETITION_PENALTY=1.1

# LLM 系統提示詞
LLM_SYSTEM_PROMPT=你是一個友善、有幫助的 Discord 機器人助手。你的名字是 {bot_name}。請提供簡潔、有用的回答。如果你不知道答案，請誠實地說出來。

# LLM 對話記憶設定
MAX_HISTORY_LENGTH=10

# 效能監控設定
ENABLE_PERFORMANCE_LOGGING=true
